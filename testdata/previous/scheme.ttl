# A concept scheme whose hierarchy is declared with skos:topConceptOf only,
# never skos:hasTopConcept, which is the case the model has to handle.

@prefix ex-cat:  <https://example.org/vocabulary/category/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .

ex-cat: a skos:ConceptScheme, owl:Ontology ;
    dcterms:title "Example Categories" ;
    dcterms:description "What a widget fundamentally is." .

ex-cat:round a skos:Concept ;
    skos:inScheme ex-cat: ;
    skos:topConceptOf ex-cat: ;
    skos:notation "round" ;
    skos:prefLabel "Round"@en ;
    skos:definition "Widgets that are round."@en .

ex-cat:square a skos:Concept ;
    skos:inScheme ex-cat: ;
    skos:topConceptOf ex-cat: ;
    skos:notation "square" ;
    skos:prefLabel "Square"@en ;
    skos:definition "Widgets that are square."@en .

ex-cat:index a skos:Concept ;
    skos:inScheme ex-cat: ;
    skos:topConceptOf ex-cat: ;
    skos:notation "index" ;
    skos:prefLabel "Index"@en ;
    skos:definition "A concept named after a reserved file stem."@en .
