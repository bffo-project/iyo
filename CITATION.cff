    family-names: Thalhath
    email: nishad@thalhath.org
    orcid: "https://orcid.org/0000-0001-9845-9714"
    affiliation: "RIKEN Center for Integrative Medical Sciences"
    city: Yokohama
    region: Kanagawa
    country: JP
  - given-names: Kozo
    family-names: Nishida
    email: knishida@riken.jp
    orcid: "https://orcid.org/0000-0001-8501-7319"
    affiliation: "RIKEN Center for Biosystems Dynamics Research"
    city: Kobe
    region: Hyōgo
    country: JP
repository-code: "https://github.com/bffo-project/iyo"
license: Apache-2.0
version: 0.1.0
keywords:
  - rdf
  - owl
  - skos
  - shacl
  - vocabulary
  - linked-data
  - content-negotiation
  - static-site-generator
