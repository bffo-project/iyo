{#-
  The layout every page extends.

  The order and the landmarks here are the accessibility floor
  (`docs/rules.md`), not decoration:

  * `charset` is the first child of head and `viewport` the second, so the
    encoding declaration is inside the first 1024 bytes and the page can
    reflow;
  * the skip link is the first element of body, outside every landmark, and
    targets `main[tabindex="-1"]` so that following it really moves focus;
  * the contents navigation precedes `main` in document order, so it is a few
    tab stops away rather than hundreds, and it is named by a visible label
    through `aria-labelledby` so that no heading precedes the `h1`;
  * every piece of content sits inside `header`, `nav`, `main` or `footer`.

  Nothing on the page needs JavaScript.
-#}
<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- if site.theme_switch %}{% include "partials/theme-switch.html.jinja" %}{% endif %}
<title>{% block title %}{{ site.title }}{% endblock %}</title>
{%- block meta %}{% endblock %}
<meta name="generator" content="{{ site.generator }} {{ site.generator_version }}">
{%- block links %}{% endblock %}
<link rel="stylesheet" href="{{ page.assets | url }}tokens.css">
<link rel="stylesheet" href="{{ page.assets | url }}theme.css">
{%- block structured_data %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#iyo-main">Skip to main content</a>
<header class="site-header">
  <nav aria-label="Site">
    <p class="site-name"><a href="{{ site.base_url | rel }}">{{ site.title }}</a></p>
    <ul class="nav-list nav-inline">
      {%- for ns in site.namespaces %}
      <li><a href="{{ ns.url | rel }}">{{ ns.title | default(ns.iri) }}</a></li>
      {%- endfor %}
    </ul>
    {%- if site.theme_switch %}{% include "partials/theme-switch-button.html.jinja" %}{% endif %}
  </nav>
</header>
{%- block contents %}{% endblock %}
<main id="iyo-main" tabindex="-1">
{% block main %}{% endblock %}
</main>
<footer class="site-footer">
  {%- if page.license or site.doc_license %}
  <p>
    {%- if page.license %}Vocabulary under <a href="{{ page.license | rel }}">{{ page.license_label }}</a>{% endif %}
    {%- if page.license and site.doc_license %}; this documentation under <a href="{{ site.doc_license | rel }}">{{ site.doc_license_label }}</a>{% endif %}
    {%- if not page.license and site.doc_license %}This documentation under <a href="{{ site.doc_license | rel }}">{{ site.doc_license_label }}</a>{% endif %}.
  </p>
  {%- endif %}
  <p class="muted">Generated by <a href="https://github.com/bffo-project/iyo">{{ site.generator }}</a> {{ site.generator_version }}. Machine-readable index: <a href="{{ site.llms_url | rel }}">llms.txt</a>.</p>
</footer>
</body>
</html>
